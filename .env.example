# Copy to .env and fill in locally. Never commit .env.
APP_ENV=development
APP_API_KEY=
DATABASE_URL=sqlite:///./sut.db
SEED_DEMO=1
EXEC_BASE_URL=
CORS_ORIGINS=
LLM_RATE_LIMIT_PER_HOUR=1000

# LLM provider for case generation and evaluation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
